#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${SCRIPT_DIR}/.."
BUILD_DIR="${ROOT_DIR}/build/examples"

print_usage() {
  cat <<'EOF'
Usage: bin/r <command> [options]

Commands:
  mult
  solve
  eigen

Run 'bin/r <command> -h' for detailed help.
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: required command '$1' not found" >&2
    exit 127
  fi
}

clean_build() {
  require_cmd cmake
  cmake -S "$ROOT_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$BUILD_DIR" --clean-first -j
}

# Load subcommand implementations
if [[ -f "$SCRIPT_DIR/cmd/mult.sh" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/cmd/mult.sh"
fi
if [[ -f "$SCRIPT_DIR/cmd/solve.sh" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/cmd/solve.sh"
fi
if [[ -f "$SCRIPT_DIR/cmd/eigen.sh" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/cmd/eigen.sh"
fi

main() {
  if [[ $# -lt 1 ]]; then
    print_usage
    exit 1
  fi
  local cmd="$1"; shift
  case "$cmd" in
    mult) cmd_mult "$@" ;;
    solve) cmd_solve "$@" ;;
    eigen) cmd_eigen "$@" ;;
    -h|--help|help) print_usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      print_usage
      exit 1
      ;;
  esac
}

main "$@"
