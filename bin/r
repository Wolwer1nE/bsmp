#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="${SCRIPT_DIR}/.."
BUILD_DIR="${ROOT_DIR}/build"

print_usage() {
  cat <<'EOF'
Usage: bin/r <command> [options]

Commands:
  mult <matrix_file> [options]
      Clean builds the project and runs the CUDA multiply test.
      Options:
        --rhs <file>          RHS vector path (required)
        --format <fmt>        Input format: triplets|matrix-market (default: triplets)
        --mults <n>           Number of chained multiplies (default: 10)
        --output <file>       Save resulting vector to path
        --verbose             Verbose kernel statistics
        --no-build            Skip cmake configure/build step (use existing build)
        --help                Show this message

  solve -m <method> [options]
      Solve a system Ax=b using the selected method.
      Currently supported methods: bicgstab
      Options:
        -m, --method <name>   Solver method (required)
        --matrix <file>       Input matrix in triplet format (required)
        --rhs <file>          RHS vector path (required)
        --output <file>       Save solution vector to path
        --no-build            Skip cmake configure/build step (use existing build)
        --help                Show this message
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: required command '$1' not found" >&2
    exit 127
  fi
}

clean_build() {
  require_cmd cmake
  cmake -S "$ROOT_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release
  cmake --build "$BUILD_DIR" --clean-first -j
}

# Load subcommand implementations
if [[ -f "$SCRIPT_DIR/cmd/mult.sh" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/cmd/mult.sh"
fi
if [[ -f "$SCRIPT_DIR/cmd/solve.sh" ]]; then
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/cmd/solve.sh"
fi

main() {
  if [[ $# -lt 1 ]]; then
    print_usage
    exit 1
  fi
  local cmd="$1"; shift
  case "$cmd" in
    mult) cmd_mult "$@" ;;
    solve) cmd_solve "$@" ;;
    -h|--help|help) print_usage ;;
    *)
      echo "Unknown command: $cmd" >&2
      print_usage
      exit 1
      ;;
  esac
}

main "$@"
