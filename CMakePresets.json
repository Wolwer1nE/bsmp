{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 18,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "common",
            "description": "Common settings for all configurations",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_STANDARD": "99",
                "CMAKE_CXX_STANDARD": "14",
                "CMAKE_CUDA_STANDARD": "14",
                "CMAKE_C_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CUDA_STANDARD_REQUIRED": "ON",
                "CMAKE_CUDA_ARCHITECTURES": "75;80;86;89;90;100",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-common",
            "description": "Common settings for gcc and clang on Linux",
            "hidden": true,
            "inherits": "common",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "generator": "Unix Makefiles"
        },
        {
            "name": "windows-common",
            "description": "Common settings for Visual Studio on Windows",
            "hidden": true,
            "inherits": "common",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "toolset": "host=x64",
            "cacheVariables": {
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
            }
        },
        {
            "name": "msvc",
            "description": "Multi-config settings for Visual Studio on Windows",
            "inherits": "windows-common"
        },
        {
            "name": "clang-debug",
            "description": "Debug settings for Clang, target Linux",
            "inherits": "linux-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clang-release",
            "description": "Release settings for Clang, target Linux",
            "inherits": "linux-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "gcc-debug",
            "description": "Debug settings for GCC, target Linux",
            "inherits": "linux-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "gcc-release",
            "description": "Release settings for GCC, target Linux",
            "inherits": "linux-common",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-debug-build",
            "configurePreset": "msvc",
            "configuration": "Debug"
        },
        {
            "name": "msvc-release-build",
            "configurePreset": "msvc",
            "configuration": "Release"
        }
    ]
}