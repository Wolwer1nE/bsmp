{
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools",
                "Shopify.ruby-lsp",
                "NVIDIA.nsight-vscode-edition"
            ]
        }
    },
    "hostRequirements": {
        "gpu": "optional"
    },
    "name": "bsmp",
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind"
}
